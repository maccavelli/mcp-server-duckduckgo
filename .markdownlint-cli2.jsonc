{
  // markdownlint-cli2 configuration for the MagicTools MCP fleet READMEs.
  // Optimized for human-readable technical documentation: tables, code
  // blocks, inline code spans, fenced shell snippets, and selective inline
  // HTML (e.g. <details>/<summary>, <br>, <kbd>) are all first-class.
  //
  // Scope: applies to READMEs and other non-agent-optimized reference docs.
  // MADR (Markdown Architectural Decision Records) and plan files are
  // EXCLUDED — they follow different conventions optimized for agent
  // consumption and would produce false-positive lint failures here.
  //
  // Rules that produce noise in long-form technical docs are disabled.
  // Style rules are pinned so the docs lint clean across the whole fleet.
  //
  // Reference: https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md

  "config": {
    // MD003 — Heading style. Pin to ATX (#) — used everywhere in the fleet.
    "MD003": { "style": "atx" },

    // MD004 — Unordered list style. Pin to dashes.
    "MD004": { "style": "dash" },

    // MD007 — Unordered list indent. 2 spaces matches the existing prose.
    "MD007": { "indent": 2 },

    // MD012 — Multiple consecutive blank lines. Keep on (catches real noise).
    // MD013 — Line length. Allow 200 for prose; exempt tables, headings,
    //         and code blocks (URLs, shell snippets, embedded JSON/YAML).
    "MD013": {
      "line_length": 200,
      "tables": false,
      "headings": false,
      "code_blocks": false
    },

    // MD022 — Headings surrounded by blank lines. Keep on.
    // MD023 — Heading must start at the beginning of the line. Keep on.
    // MD024 — Multiple headings with the same content. Allow siblings
    //         (e.g. ### Step 1: ... appears in multiple subdirs).
    "MD024": { "siblings_only": true },

    // MD025 — Single title. Allow multiple H1s in a single doc (some
    //         READMEs have an org-name H1 + a project-name H1).
    "MD025": { "front_matter_title": "" },

    // MD026 — No trailing punctuation in headings. Allow "?" and ":"
    //         (we use them in many section titles like "Why the Server Exists?").
    "MD026": { "punctuation": ".,;!。，；：！" },

    // MD029 — Ordered list item prefix. "ordered" permits 1./2./3. and
    //         also 1./1./1. (re-numbers automatically).
    "MD029": { "style": "ordered" },

    // MD030 — Spaces after list markers. Pin to 1.
    "MD030": { "ul_single": 1, "ol_single": 1, "ul_multi": 1, "ol_multi": 1 },

    // MD033 — Inline HTML. Allow (we use <details>/<summary>, <br>, <kbd>,
    //         <sub>, <sup>, etc. intentionally in tables and callouts).
    "MD033": false,

    // MD035 — Horizontal rule style. Pin to "---".
    "MD035": { "style": "---" },

    // MD036 — Emphasis used instead of a heading. Disabled — we often
    //         use bold lead-ins (e.g. "**MANDATORY WORKFLOW:**") as
    //         paragraph-level callouts rather than as headings.
    "MD036": false,

    // MD041 — First line in a file should be a top-level heading. Disabled
    //         so the version-stamp blockquote and front matter are allowed.
    "MD041": false,

    // MD046 — Code block style. Pin to fenced.
    "MD046": { "style": "fenced" },

    // MD047 — File should end with a single newline. Keep on.
    // MD048 — Code fence style. Pin to backticks.
    "MD048": { "style": "backtick" },

    // MD049 — Emphasis style. Pin to asterisks (matches all existing docs).
    "MD049": { "style": "asterisk" },

    // MD050 — Strong style. Pin to asterisks.
    "MD050": { "style": "asterisk" },

    // MD060 — Table column style. Disabled — overly pedantic when table
    //         cells contain inline code spans (e.g. `json` | `markdown`).
    "MD060": false
  },

  // Glob patterns.
  //
  // INCLUDE: all markdown files by default.
  // EXCLUDE:
  //   1. Build / dependency / VCS trees (node_modules, vendor, dist, .git).
  //   2. Agent-optimized docs:
  //        - MADR / ADR files (case-insensitive: MADR-*.md, NNNN-MADR-*.md, etc.)
  //        - Plan files (PLAN-*.md, plan.md, *-plan-*.md, etc., case-insensitive)
  //        - `plans/` directories (case-insensitive: docs/plans/, Plans/, etc.)
  //
  // To also exclude other agent-targeted files (AGENTS.md, CLAUDE.md,
  // TODO.md, ROADMAP.md), uncomment the additional patterns below.
  "globs": [
    "**/*.md",

    // Build / dependency / VCS trees
    "!**/node_modules/**",
    "!**/vendor/**",
    "!**/dist/**",
    "!**/.git/**",

    // MADR (Markdown Architectural Decision Records) — case-insensitive.
    // Matches: MADR-foo.md, NNNN-MADR-foo.md, madr-foo.md, foo-madr.md, etc.
    "!**/MADR*.md",
    "!**/*MADR*.md",
    "!**/madr*.md",
    "!**/*madr*.md",

    // Plan files — case-insensitive.
    // Matches: PLAN-foo.md, plan.md, foo-plan.md, foo-action-plan.md,
    //          2026-04-03-foo-impl-plan.md, foo-PLAN.md, etc.
    "!**/PLAN*.md",
    "!**/*PLAN*.md",
    "!**/*[Pp]lan*.md",

    // Plans directories — case-insensitive.
    // Matches: docs/plans/, docs/Plans/, top-level plans/, etc.
    "!**/plans/**",
    "!**/Plans/**"

    // Optional additional agent-targeted exclusions (uncomment as needed):
    // , "!**/AGENTS.md"
    // , "!**/CLAUDE.md"
    // , "!**/TODO.md"
    // , "!**/ROADMAP.md"
  ]
}
